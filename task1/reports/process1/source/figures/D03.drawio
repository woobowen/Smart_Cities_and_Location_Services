        </mxCell>
        <mxCell id="d" value="方向规则D专项核验&#10;方向定义、环形角差&#10;不可计算窗口、同步删除&#10;完整输入与原始点身份" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFDFC;strokeColor=#5B9FBE;fontColor=#2D3238;fontFamily=Noto Sans CJK SC;fontSize=17;spacing=10;">
          <mxGeometry x="349" y="186" width="302" height="112" as="geometry" />
        </mxCell>
        <mxCell id="p" value="简化P专项核验&#10;有限线段距离、端点&#10;原始索引、退化情况&#10;DP即时输入的误差检查" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFDFC;strokeColor=#5B9FBE;fontColor=#2D3238;fontFamily=Noto Sans CJK SC;fontSize=17;spacing=10;">
          <mxGeometry x="676" y="186" width="302" height="112" as="geometry" />
