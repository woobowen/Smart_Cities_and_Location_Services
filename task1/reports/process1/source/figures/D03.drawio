        <mxCell id="shared" value="共同入口&#10;同一数据范围、独立原始参考、明确统计单位&#10;固定主要指标、保护条件、预算和各数据分区用途" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFDFC;strokeColor=#B97589;fontColor=#2D3238;fontFamily=Noto Sans CJK SC;fontSize=17;spacing=10;">
