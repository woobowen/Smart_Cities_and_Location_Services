        </mxCell>
        <mxCell id="s" value="分段S专项核验&#10;断点条件、等号与边界归属&#10;片段索引、过滤原因&#10;断边不计入段内长度" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFDFC;strokeColor=#5B9FBE;fontColor=#2D3238;fontFamily=Noto Sans CJK SC;fontSize=17;spacing=10;">
